**/__pycache__/**
debug*
exps
results
wandb
outputs
.vscode
checkpoints
data
figs
*.ipynb
cache
.venv

# generated by scripts/gen_samples.py --write (manifest, array script, task logs)
scripts/samples/

# generated by scripts/report_metrics.py and scripts/metrics_cv.py -- all of the
# metric caches, so a clone rebuilds them rather than inheriting a stale one
scripts/metrics*.csv
scripts/figs/

# generated by scripts/gen_samples_cv.py --write (manifest, array script)
scripts/samples_cv/

# PNG previews of the paper figures: byte-for-byte duplicates of the .pdf beside
# them, 6.7MB of binaries git would have to carry forever. Regenerated by
# notebooks/kps_paper.ipynb along with the PDFs.
notebooks/paper/*.png
notebooks/paper_cv/*.png

# the compiled draft itself (20MB), not an asset of this repo
notebooks/paper/LFKPS-*.pdf
